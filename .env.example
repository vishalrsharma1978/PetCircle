# App
# APP_BASE_URL is currently not read by any code (reserved for future use,
# same as PAWCIRCLE_ENABLE_EMAIL) — kept here as documentation of the
# canonical URL, not a functioning config value.
APP_BASE_URL=https://pawcircle.space
APP_SESSION_SECRET=

# CORS allowlist for the frontend -> api/index.php calls (api/index.php:73).
# Comma-separated, no spaces, no trailing slash. Falls back to
# http://localhost:5500,http://127.0.0.1:5500 if left blank, so this MUST be
# set explicitly in production or the live site's own requests will be
# rejected as cross-origin.
ALLOWED_ORIGINS=https://pawcircle.space

# Supabase (same project as current PetCircle: uaihbooqmkibhkubwipu)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Transactional email — sendEmailMessage() in api/routes/auth.php sends via
# SendPulse's SMTP API (get a Client ID/Secret from SendPulse dashboard ->
# Settings -> API). If either is blank, emails are mocked (logged, not sent) -
# was ESAMAJ_ENABLE_EMAIL / ESAMAJ_FROM_EMAIL / ESAMAJ_FROM_NAME upstream, but
# PAWCIRCLE_ENABLE_EMAIL itself is currently unused/dead code, not a gate.
PAWCIRCLE_ENABLE_EMAIL=false
PAWCIRCLE_FROM_EMAIL=
PAWCIRCLE_FROM_NAME=PawCircle
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=

# Reserved, not currently read by any code (no Resend integration exists in
# this codebase — SendPulse above is the only email provider actually wired up)
RESEND_API_KEY=

# AWS S3 (media storage, if used instead of/alongside Supabase Storage).
# ALL FOUR must be non-empty for the S3 path to activate — s3IsConfigured()
# (api/routes/s3_storage.php) requires every one, otherwise uploads fall back to
# Supabase Storage. The bucket MUST grant anonymous s3:GetObject on the
# petcircle/ prefix via a bucket policy, or media 403s in the browser even though
# uploads report success. Setup runbook: docs/aws-s3-setup.md
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: CDN / custom-domain origin for the public media URLs written into the
# database. No trailing slash (e.g. https://cdn.pawcircle.space). When blank,
# URLs use https://<bucket>.s3.<region>.amazonaws.com/<key>. Changing this does
# NOT rewrite URLs already stored in the DB.
# AWS_S3_PUBLIC_BASE_URL=

# Optional: S3 API endpoint override for S3-compatible providers (Cloudflare R2,
# MinIO, Backblaze B2). No trailing slash. Leave blank for real AWS S3.
# AWS_S3_ENDPOINT=

# Optional: after each S3 upload, anonymously HEAD the resulting public URL and
# reject the upload if it isn't publicly readable, instead of persisting a dead
# URL. Defaults to true. Set false only to bypass the check in an emergency
# (e.g. it misfires behind a CDN that blocks HEAD).
# PAWCIRCLE_VERIFY_PUBLIC_MEDIA=true

# Debug (never enable in production)
PAWCIRCLE_DEBUG=false

# Zoom (voice/video calling via api/routes/zoom.php + public/js/zoom.js) —
# actually wired up and required for calling to work, despite the name
# suggesting otherwise. All six are read directly by zoom.php.
ZOOM_HOST_USER_ID=
ZOOM_MEETING_SDK_CLIENT_ID=
ZOOM_MEETING_SDK_CLIENT_SECRET=
ZOOM_S2S_ACCOUNT_ID=
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=
