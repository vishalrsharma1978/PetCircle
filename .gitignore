# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# Composer only. Anchored so it does not also swallow public/js/vendor/,
# whose bundles are committed deliberately (there is no Node on the
# Hostinger deploy host, so nothing would restore them there).
/vendor
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
service-role*.json
databaseSecrets.md

# Data and Schema dumps (we keep sql_scripts/schema.sql but ignore others if needed, though they are inside sql_scripts now)
# We will not globally ignore *.sql so that schema files can be checked in.
# Ignoring specific data dumps if they are generated locally:
sql_scripts/data.sql
sql_scripts/schema_dump_final.sql

# powershells
*.ps*

# other
*.png
*.txt

# Temporary merge resolution files
_merge_temp/

# Local Supabase backup (contains real user emails, password/session/CSRF
# token hashes, IP hashes — local-only, never commit)
schema/

# Graphify
graphify-out/
.graphifyignore

# Patches
*.patch

*.md
*.py
scratch/
test_*

# Stray shell-redirect debris (accidental `... > q`-style artifact)
/q