# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# Composer only. Anchored so it does not also swallow public/js/vendor/,
# whose bundles are committed deliberately (there is no Node on the
# Hostinger deploy host, so nothing would restore them there).
/vendor
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
service-role*.json
databaseSecrets.md

# Data and Schema dumps (we keep sql_scripts/schema.sql but ignore others if needed, though they are inside sql_scripts now)
# We will not globally ignore *.sql so that schema files can be checked in.
# Ignoring specific data dumps if they are generated locally:
sql_scripts/data.sql
sql_scripts/schema_dump_final.sql

# powershells
*.ps*

# other
*.png
*.txt

# ...except these. The blanket *.png / *.txt rules above are aimed at
# stray screenshots and scratch notes, and they were silently swallowing
# real source assets.

# The cut hero layers. The auth hero cannot render without them and there
# is no build step to regenerate them on deploy.
!public/assets/mascots/hero/*.png

# The source photographs the layers are cut from, and the prompt recipe
# that produced them. Without these the layer coordinates baked into
# AV2_HERO_PHOTOS (public/js/auth_scene.js) cannot be re-derived, and a
# new species cannot be generated to match the existing set.
!incoming-mascots/*.png
!incoming-mascots/PROMPTS.txt

# Superseded: this is the first cat, generated before the prompt banned
# contact shadows. Its shadow sits inside the cat's own brightness range
# so it cannot be keyed out — cat1.png is the one actually used. Kept on
# disk as a reference for what NOT to accept, but not worth 852KB in the
# repository.
incoming-mascots/cat.png

# Temporary merge resolution files
_merge_temp/

# Local Supabase backup (contains real user emails, password/session/CSRF
# token hashes, IP hashes — local-only, never commit)
schema/

# Graphify
graphify-out/
.graphifyignore

# Patches
*.patch

*.md
*.py
scratch/
test_*

# Stray shell-redirect debris (accidental `... > q`-style artifact)
/q